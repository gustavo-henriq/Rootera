{
  "expo": {
    "name": "Rootera",
    "slug": "rootera",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rootera",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rootera.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rootera.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#34431D"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Rootera",
      "favicon": "./assets/favicon.png",
      "themeColor": "#F3F5EC"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rootera uses your approximate area once to adjust watering to the local weather."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rootera to use a photo for your plant profile.",
          "cameraPermission": "Allow Rootera to photograph your plant.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Rootera to photograph your plant.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5EC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F130B"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
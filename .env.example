# App configuration: copy to .env. Only PUBLIC values belong here, because Expo embeds
# every EXPO_PUBLIC_* value in the app bundle. Secrets live in backend/.env only.

# Where the API is. "metro" (recommended for local runs): the Expo dev server forwards
# /rootera-api/* to the API on this computer (port 8000), so a phone on the same Wi-Fi
# (or an Expo tunnel) needs only the dev server's address. A full URL also works,
# e.g. http://192.168.0.12:8000 or https://api.example.com.
EXPO_PUBLIC_API_URL=metro
# Preview access token (local demo mode; per-user accounts are future work).
EXPO_PUBLIC_DEMO_TOKEN=rootera-local-demo

# RevenueCat PUBLIC SDK keys (Project settings > API keys). All optional.
# Without any key, the Plans screen runs in a clearly labelled preview mode (no charge).
# Real (or Test Store) purchases need a development build: in Expo Go the SDK switches
# to RevenueCat's Preview API mode, which mocks purchases.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# Test Store key: test purchases with no App Store or Google Play account.
# EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_...

# App configuration (copy to .env). Only PUBLIC values belong here: Expo embeds
# every EXPO_PUBLIC_* value in the app bundle.

# Backend address. On a physical phone use your computer's LAN IP, e.g. http://192.168.0.12:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Preview access token (demo mode only; real accounts will replace it).
EXPO_PUBLIC_DEMO_TOKEN=rootera-local-demo

# RevenueCat PUBLIC SDK keys (Project settings > API keys). Leave empty for preview mode.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# Test Store key, works in Expo Go and the web preview without store accounts:
# EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_...

# Copy to backend/.env and start the API with:  uvicorn app.main:app --env-file .env
# Everything in this file stays on the server. Never put these values in the app.

# Database. Default: SQLite in backend/rootera.db
# DATABASE_URL=postgresql+psycopg://rootera:YOUR_PASSWORD@YOUR_HOST:5432/rootera

ROOTERA_DEMO=true
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Production/remote: ROOTERA_DEMO=false and private per-user bearer tokens.
# ROOTERA_USER_TOKENS={"replace-with-random-private-token":"user-id"}

# New gardens are empty. Set true only to seed example plants in a NEW demo database.
ROOTERA_SEED_DEMO=false

# RevenueCat (server side). Secret API key: Project settings > API keys > Secret key (sk_...).
# REVENUECAT_SECRET_KEY=
# Entitlement identifier configured in RevenueCat.
REVENUECAT_ENTITLEMENT=plus
# Optional webhook: set the same value as the Authorization header in RevenueCat > Integrations > Webhooks.
# REVENUECAT_WEBHOOK_AUTH=

# Pl@ntNet photo identification (https://my.plantnet.org). Leave empty to keep it off.
# PLANTNET_API_KEY=

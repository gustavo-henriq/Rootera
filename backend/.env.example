# Default: SQLite in backend/rootera.db
# DATABASE_URL=postgresql+psycopg://rootera:YOUR_PASSWORD@YOUR_HOST:5432/rootera
ROOTERA_DEMO=true
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Production/remote: ROOTERA_DEMO=false; supply private per-user bearer credentials.
# ROOTERA_USER_TOKENS={"replace-with-random-private-token":"user-id"}

# New gardens are empty. Set true only to seed example plants in a NEW demo database.
ROOTERA_SEED_DEMO=false
